# ORSync — Fastlane lanes for shipping to TestFlight.
#
# Runs either on your Mac (Xcode installed) or on a GitHub Actions macOS runner
# (see .github/workflows/ios-testflight.yml). One-time setup is in
# docs/TESTFLIGHT.md. After that, shipping a beta is just:  fastlane beta
#
# Authentication uses an App Store Connect API key (no interactive 2FA) when
# these env vars are set:
#   APP_STORE_CONNECT_API_KEY_ID, APP_STORE_CONNECT_API_ISSUER_ID,
#   APP_STORE_CONNECT_API_KEY      (the .p8 contents)  — or _KEY_PATH (a file)

default_platform(:ios)

WORKSPACE = "ios/App/App.xcworkspace"
PROJECT   = "ios/App/App.xcodeproj"
SCHEME    = "App"

def api_key
  return nil unless ENV["APP_STORE_CONNECT_API_KEY_ID"]
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
    key_content: ENV["APP_STORE_CONNECT_API_KEY"],     # raw .p8 contents (CI secret)
    key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"], # or a path to the .p8
    is_key_content_base64: ENV["APP_STORE_CONNECT_API_KEY_B64"] == "1",
    in_house: false,
  )
end

platform :ios do
  desc "Build the web app and (re)generate the native iOS project"
  lane :sync do
    sh("cd .. && npm ci && npm run build")
    # Create the native project on first run, then sync the web build into it.
    unless File.directory?("../ios")
      sh("cd .. && npx cap add ios")
      sh("cd .. && npx capacitor-assets generate --ios") rescue nil
    end
    sh("cd .. && npx cap sync ios")

    # Exempt-encryption flag so TestFlight never shows the export-compliance
    # prompt (the app only uses standard HTTPS).
    plist = "../ios/App/App/Info.plist"
    sh(%(/usr/libexec/PlistBuddy -c "Add :ITSAppUsesNonExemptEncryption bool false" "#{plist}" 2>/dev/null || /usr/libexec/PlistBuddy -c "Set :ITSAppUsesNonExemptEncryption false" "#{plist}"))
  end

  desc "Build and upload a new build to TestFlight"
  lane :beta do
    sync
    key = api_key

    # Optional: install distribution certs + profiles from a match repo. Not
    # required — without it we use Xcode *cloud signing* below, where Apple
    # manages the distribution certificate and the API key authorizes it.
    if ENV["MATCH_GIT_URL"]
      match(type: "appstore", readonly: true, api_key: key)
    end

    increment_build_number(
      xcodeproj: PROJECT,
      build_number: latest_testflight_build_number(api_key: key, initial_build_number: 0) + 1,
    )

    # Make signing fully non-interactive on an ephemeral runner: set the team,
    # and hand xcodebuild the App Store Connect API key so automatic signing can
    # register/refresh the provisioning profile and sign with Apple's
    # cloud-managed distribution certificate — no local certs, no match repo,
    # no 2FA prompt. (On a Mac with Xcode signed in, this also just works.)
    team = ENV["APPLE_TEAM_ID"]
    xcargs = []
    xcargs << "DEVELOPMENT_TEAM=#{team}" if team && !team.empty?
    auth = []
    unless ENV["MATCH_GIT_URL"]
      xcargs << "CODE_SIGN_STYLE=Automatic"
      auth << "-allowProvisioningUpdates"
      if ENV["APP_STORE_CONNECT_API_KEY_PATH"]
        auth << "-authenticationKeyPath #{File.expand_path(ENV["APP_STORE_CONNECT_API_KEY_PATH"])}"
        auth << "-authenticationKeyID #{ENV["APP_STORE_CONNECT_API_KEY_ID"]}"
        auth << "-authenticationKeyIssuerID #{ENV["APP_STORE_CONNECT_API_ISSUER_ID"]}"
      end
      xcargs.concat(auth)
    end

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      output_directory: "build",
      clean: true,
      xcargs: xcargs.empty? ? nil : xcargs.join(" "),
      # The export/re-sign step needs the same authorization as the archive.
      export_xcargs: auth.empty? ? nil : auth.join(" "),
      export_team_id: team,
    )

    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end
end
