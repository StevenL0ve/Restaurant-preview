# CGP — Fastlane lanes (run on a Mac with Xcode).
#
# One-time setup is in docs/TESTFLIGHT.md. After that, shipping a beta is:
#   fastlane beta
#
# This builds the Capacitor iOS app and uploads it to TestFlight.

default_platform(:ios)

WORKSPACE = "ios/App/App.xcworkspace"
SCHEME = "App"

platform :ios do
  desc "Build the web app and sync it into the native iOS project"
  lane :sync do
    sh("cd .. && npm run build && npx cap sync ios")
  end

  desc "Build and upload a new build to TestFlight"
  lane :beta do
    sync

    # Bump the build number to the next TestFlight number for this version.
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: latest_testflight_build_number(initial_build_number: 0) + 1
    )

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      output_directory: "build",
      clean: true
    )

    # Uses an App Store Connect API key if APP_STORE_CONNECT_API_KEY_PATH is set
    # (recommended — avoids 2FA prompts). See docs/TESTFLIGHT.md.
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
