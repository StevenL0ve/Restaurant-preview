# Fastlane app configuration for ORSync.
#
# Nothing to edit here: everything sensitive comes from the environment.
# All lanes authenticate with an App Store Connect API key, so an Apple ID
# email isn't needed at all. Set APPLE_TEAM_ID (and optionally APPLE_ID /
# ITC_TEAM_ID) as env vars or CI secrets.
app_identifier("com.stevennelson.orsync")
apple_id(ENV["APPLE_ID"]) if ENV["APPLE_ID"]
team_id(ENV["APPLE_TEAM_ID"]) if ENV["APPLE_TEAM_ID"]
itc_team_id(ENV["ITC_TEAM_ID"]) if ENV["ITC_TEAM_ID"]
