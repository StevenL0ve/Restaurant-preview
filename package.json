{
  "name": "coparent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CoParent — a modern, fast, free co-parenting app. A better OurFamilyWizard.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  },
  "//": "Icon/asset generation needs `npm i -D sharp @capacitor/assets` on demand; they are not committed deps because their native binaries can't install in every environment. The CI workflows fetch @capacitor/assets via npx."
}
