# My Cellar — environment configuration
# The preview build needs no backend: your cellar lives in the browser's
# localStorage and can be exported as JSON at any time. When a hosted backend
# is added, copy this to .env.local and fill in the PUBLISHABLE values below
# (safe in a client app; protected by Row-Level Security).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
